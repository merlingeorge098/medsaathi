# Required in production: long random string used to sign session cookies and email action links
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of the deployment (used inside emails)
APP_URL=https://your-app.vercel.app

# Secret that cron-job.org (or Cloud Scheduler) sends in the x-cron-secret header
CRON_SECRET=another-long-random-string

# Firestore (Firebase Admin). Leave empty to run on the built-in in-memory demo store.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n line breaks
FIREBASE_PRIVATE_KEY=

# Gmail SMTP (use an App Password, not your normal password). Leave empty to log emails to the in-app outbox only.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Gemini API key from Google AI Studio (prescription scanning + doctor summary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
